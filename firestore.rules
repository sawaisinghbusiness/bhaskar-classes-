rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // 1. Admins Collection
    // CRITICAL: Prevent unauthorized privilege escalation!
    // Nobody from client SDK can create or update admin documents.
    match /admins/{adminId} {
      allow get: if isAuthenticated() && (request.auth.uid == adminId || isAdmin());
      allow list: if isAdmin();
      allow write: if false; // Only manageable via Firebase Console
    }

    // 2. Students Collection
    match /students/{studentId} {
      // Read: Student reads own profile, Admin reads all
      allow get: if isOwner(studentId) || isAdmin();
      allow list: if isAdmin();

      // Create: Student creates own document on registration
      // Cannot self-grant access!
      allow create: if isOwner(studentId)
                    && request.resource.data.uid == studentId
                    && request.resource.data.hasEbooksAccess == false
                    && request.resource.data.hasTestSeriesAccess == false;

      // Update:
      // - Admin can update any field (grant notes, tracking, etc.)
      // - Student can ONLY update safe fields (name, phone, targetExam, etc.)
      //   and CANNOT touch hasEbooksAccess, hasTestSeriesAccess, or bookOrders!
      allow update: if isAdmin() || (
        isOwner(studentId)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['hasEbooksAccess', 'hasTestSeriesAccess', 'bookOrders', 'uid'])
      );

      // Delete: Strictly Admin only
      allow delete: if isAdmin();
    }

    // 3. Inquiries Collection (Contact Leads)
    match /inquiries/{inquiryId} {
      allow create: if request.resource.data.name is string
                    && request.resource.data.phone is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() <= 100
                    && request.resource.data.phone.size() >= 10
                    && request.resource.data.phone.size() <= 15;
      allow read, list, update, delete: if isAdmin();
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
